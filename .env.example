# Initial local-only browser test. Use the GUI/manual to choose LAN or Tailscale access.
# Comma-separated exact browser origins (no trailing slash, paths or wildcards).
PUBLIC_ORIGINS=http://localhost:8080
# Legacy single-origin fallback when PUBLIC_ORIGINS is unset or empty.
# PUBLIC_ORIGIN=https://rdp.example.com
# Exact host:port pairs, comma-separated without spaces. Match Ubuntu's displayed RDP port.
# Use this exact hostname and port in the browser's desktop connection form.
RDP_TARGETS=host.docker.internal:3389
# Prefer a trusted RDP certificate. True explicitly disables RDP certificate verification.
RDP_IGNORE_CERT=false
# Initial loopback binding. The GUI can select an assigned private LAN IPv4 address.
RDP_BIND_ADDRESS=127.0.0.1
