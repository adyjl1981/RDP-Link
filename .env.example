# Generate with: openssl rand -hex 32
GATEWAY_SECRET=replace-with-a-long-random-access-key
# Exact HTTPS origin used on your iPhone (no trailing slash).
PUBLIC_ORIGIN=https://rdp.example.com
# Comma-separated host:port pairs. Use this exact address in the connection form.
RDP_TARGETS=host.docker.internal:3389
# Prefer a trusted RDP certificate. Set true only for your known desktop's self-signed certificate.
RDP_IGNORE_CERT=false
